# --- LLM Provider: Groq (free tier) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- App settings ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Voice (Phase 4) ---
WHISPER_MODEL_SIZE=base

# --- Security (Phase 5) ---
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DRIVE_TOKEN_ENCRYPTION_KEY=
# Lower = stricter (fewer questions force RAG routing), higher = looser.
# See README "Fix #2" for how to tune this against your real data.
RELEVANCE_DISTANCE_THRESHOLD=0.9

# --- WhatsApp Business Platform (Phase 6) ---
# See README "WhatsApp setup" for how to get these from the Meta App dashboard.
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_yourself
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Twilio WhatsApp Sandbox (alternative to Meta's Cloud API) ---
# See README "Twilio setup" — used if Meta's own developer registration is blocked
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# NOTE: This project intentionally does NOT use ANTHROPIC_API_KEY.
# Groq's free API is the LLM provider for the whole build.
